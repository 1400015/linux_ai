# Template para criar pacote XBPS para linux-ai-assistant
# Este ficheiro deve ser colocado em /var/db/xbps/srcpkgs/

pkgname=linux-ai-assistant
version=1.0.0
revision=1
wrksrc="linux-ai-assistant-${version}"
build_style=python3-module
make_build_deps="python3-setuptools"
hostmakedepends="python3-pip python3-venv git"

short_desc="Assistente de IA permanente para Linux com interface flutuante"
maintainer="Joao Azevedo <joao@example.com>"
license="MIT"
homepage="https://github.com/1400015/linux_ai"

# Dependências de execução
depends="python3 python3-gobject python3-cairo py3-gobject py3-cairo gtk+3 scrot tesseract-ocr tesseract-ocr-por tesseract-ocr-eng libappindicator-gtk3"

# Arquivos a instalar
filesites="https://github.com/1400015/linux_ai/archive/refs/tags/v${version}.tar.gz"
distfiles="${wrksrc}.tar.gz"

# Instalação
post_install() {
	# Criar diretório de configuração
	install -d -m 755 ${DESTDIR}/home/void/.config/linux_ai_assistant
	
	# Copiar ficheiros de configuração
	install -D -m 644 ${wrksrc}/config/config.json ${DESTDIR}/home/void/.config/linux_ai_assistant/config.json
	install -D -m 644 ${wrksrc}/config/.env.example ${DESTDIR}/home/void/.config/linux_ai_assistant/.env
	
	# Criar atalho de aplicação
	install -d -m 755 ${DESTDIR}/home/void/.local/share/applications
	install -D -m 644 ${wrksrc}/scripts/linux-ai-assistant.desktop ${DESTDIR}/home/void/.local/share/applications/linux-ai-assistant.desktop
	
	# Criar ícone
	install -d -m 755 ${DESTDIR}/home/void/.local/share/icons/hicolor/64x64/apps
	install -D -m 644 ${wrksrc}/assets/icon.png ${DESTDIR}/home/void/.local/share/icons/hicolor/64x64/apps/linux-ai-assistant.png
	
	# Criar script de execução
	install -d -m 755 ${DESTDIR}/usr/bin
	install -D -m 755 ${wrksrc}/run.sh ${DESTDIR}/usr/bin/linux-ai-assistant
	
	# Criar ambiente virtual (será criado na primeira execução)
	install -d -m 755 ${DESTDIR}/usr/share/linux-ai-assistant
	cp -r ${wrksrc}/src ${DESTDIR}/usr/share/linux-ai-assistant/
	cp ${wrksrc}/requirements.txt ${DESTDIR}/usr/share/linux-ai-assistant/
	cp ${wrksrc}/setup.py ${DESTDIR}/usr/share/linux-ai-assistant/
	
	# Mensagem de instalação
	vmessage "Linux AI Assistant instalado!"
	vmessage "Para configurar, edite: ~/.config/linux_ai_assistant/.env"
	vmessage "Para executar: linux-ai-assistant"
}

# Desinstalação
post_remove() {
	# Remover ficheiros de configuração
	rm -rf ${DESTDIR}/home/void/.config/linux_ai_assistant
	
	# Remover atalho
	rm -f ${DESTDIR}/home/void/.local/share/applications/linux-ai-assistant.desktop
	
	# Remover ícone
	rm -f ${DESTDIR}/home/void/.local/share/icons/hicolor/64x64/apps/linux-ai-assistant.png
	
	# Remover script de execução
	rm -f ${DESTDIR}/usr/bin/linux-ai-assistant
	
	# Remover ficheiros da aplicação
	rm -rf ${DESTDIR}/usr/share/linux-ai-assistant
	
	vmessage "Linux AI Assistant removido!"
}
