+class Config:
+    def __init__(self, values=None):
+        self.values = values or {}
+
+    def get(self, key, default=None):
+        return self.values.get(key, default)
+
+
+class Response:
+    def __init__(self, lines=(), data=None):
+        self.lines = lines
+        self.data = data
+        self.closed = False
+
+    def iter_lines(self):
+        return iter(self.lines)
+
+    def json(self):
+        return self.data
+
+    def close(self):
+        self.closed = True
