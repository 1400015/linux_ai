{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "operation_id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
    },
    "session_id": {
      "type": "string",
      "maxLength": 128,
      "minLength": 1
    },
    "action_id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
    },
    "resource": {
      "type": "string",
      "maxLength": 1024
    },
    "risk": {
      "enum": [
        "read",
        "change",
        "high",
        "destructive"
      ]
    },
    "phase": {
      "enum": [
        "prepared",
        "running",
        "verified",
        "failed",
        "pending",
        "confirmed",
        "reverted",
        "recovery_failed",
        "command"
      ]
    },
    "timestamp": {
      "type": "number",
      "minimum": 0
    },
    "detail": {
      "type": "string",
      "maxLength": 4096
    }
  },
  "required": [
    "schema_version",
    "operation_id",
    "session_id",
    "action_id",
    "resource",
    "risk",
    "phase",
    "timestamp",
    "detail"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
