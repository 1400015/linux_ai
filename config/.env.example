# API Keys configuration
# Copy this file to `.env` next to config.json and fill in your keys.
#
# Canonical form: LINUX_AI_<CONFIG_KEY_UPPERCASED>, dots -> underscores.
# The two legacy names below are also honoured for backward compatibility.
# Uncomment only a key that you intend to provide through this file.
# A canonical variable defined with an empty value disables its stored key.

# --- Providers -----------------------------------------------------------
# LINUX_AI_API_PROVIDERS_OPENROUTER_API_KEY=
# LINUX_AI_API_PROVIDERS_GOOGLE_AI_STUDIO_API_KEY=
# LINUX_AI_API_PROVIDERS_ANTHROPIC_API_KEY=
# LINUX_AI_API_PROVIDERS_MISTRAL_API_KEY=
# LINUX_AI_API_PROVIDERS_GROQ_API_KEY=
# LINUX_AI_API_PROVIDERS_COHERE_API_KEY=

# Legacy names (still read for openrouter / google_ai_studio)
# OPENROUTER_API_KEY=
# GOOGLE_AI_STUDIO_KEY=

# --- Optional: overrides for any config key ------------------------------
# Examples:
# LINUX_AI_API_DEFAULT_PROVIDER=openrouter
# LINUX_AI_APP_ALWAYS_ON_TOP=true
# LINUX_AI_APP_OPACITY=0.9
# LINUX_AI_APP_LANGUAGE=pt

# --- Local model (Ollama / llama.cpp / any OpenAI-compatible server) ------
LINUX_AI_API_PROVIDERS_LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LINUX_AI_API_PROVIDERS_LOCAL_LLM_MODEL=llama3.2
