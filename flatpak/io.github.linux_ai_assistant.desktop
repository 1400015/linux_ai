[Desktop Entry]
Version=1.0
Type=Application
Name=Linux AI Assistant
Comment=Assistente de IA permanente para Linux
Exec=linux-ai-assistant --show
Icon=io.github.linux_ai_assistant
Terminal=false
Categories=Utility;System;
StartupWMClass=io.github.linux_ai_assistant
StartupNotify=true
Actions=new-window;

[Desktop Action new-window]
Name=Nova Janela
Exec=linux-ai-assistant --show
