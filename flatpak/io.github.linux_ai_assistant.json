{
    "app-id": "io.github.linux_ai_assistant",
    "runtime": "org.freedesktop.Platform",
    "runtime-version": "25.08",
    "sdk": "org.freedesktop.Sdk",
    "command": "linux-ai-assistant",
    "finish-args": [
        "--share=ipc",
        "--share=network",
        "--socket=wayland",
        "--socket=x11",
        "--device=dri",
        "--filesystem=home",
        "--filesystem=xdg-config",
        "--filesystem=xdg-cache",
        "--talk-name=org.freedesktop.Notifications",
        "--talk-name=org.kde.StatusNotifierWatcher",
        "--talk-name=org.gtk.vfs.*"
    ],
    "modules": [
        {
            "name": "linux-ai-assistant",
            "buildsystem": "simple",
            "build-commands": [
                "pip3 install --prefix=/app --no-deps -r requirements.txt",
                "cp -r src /app/bin/",
                "cp -r config /app/bin/",
                "cp -r scripts /app/bin/",
                "cp -r plugins /app/bin/",
                "cp -r themes /app/bin/",
                "cp scripts/flatpak-launch.sh /app/bin/linux-ai-assistant",
                "chmod +x /app/bin/linux-ai-assistant",
                "mkdir -p /app/share/linux-ai-assistant",
                "cp README.md /app/share/linux-ai-assistant/",
                "cp LICENSE /app/share/linux-ai-assistant/",
                "mkdir -p /app/share/applications",
                "cp flatpak/io.github.linux_ai_assistant.desktop /app/share/applications/io.github.linux_ai_assistant.desktop",
                "mkdir -p /app/share/icons/hicolor/scalable/apps",
                "cp assets/io.github.linux_ai_assistant.svg /app/share/icons/hicolor/scalable/apps/"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": "..",
                    "skip": [".git", "venv", ".vscode", "*.pyc", "__pycache__", ".DS_Store"]
                }
            ]
        }
    ]
}
